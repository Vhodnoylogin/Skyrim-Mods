# Продукты сборки и окружения в репозиторий не попадают.
build/
dist/
.venv/
models/
__pycache__/
*.pyc

# Логи, токены и локальные настройки - у каждой машины свои.
*.log
*-token.txt
build.local.json

# Черновики прогонов.
session.jsonl
*.wav
*.bak-*

# --- Lycan Body ---
# Распакованные исходники и промежуточные сборки: восстанавливаются из архивов,
# места занимают много, версионировать нечего.
work/*
!work/README.md
# assets\ ВЕРСИОНИРУЕТСЯ - через Git LFS, см. .gitattributes и assets/README.md.
# Здесь лежит невосстановимое: скульпт .blend, вылепленная руками геометрия, готовые
# .esp. Рецепт без этих файлов не исполняется, поэтому исключать их нельзя.
