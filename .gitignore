# Продукты сборки и окружения в репозиторий не попадают.
build/
dist/
.venv/
models/
__pycache__/
*.pyc

# Логи, токены и локальные настройки - у каждой машины свои.
*.log
*-token.txt
build.local.json

# Черновики прогонов.
session.jsonl
*.wav
*.bak-*

# --- Lycan Body ---
# Распакованные исходники и промежуточные сборки: восстанавливаются из архивов,
# места занимают много, версионировать нечего.
work/*
!work/README.md
# Невосстановимое ручное: .blend со скульптом, вылепленная геометрия, готовые .esp.
# Двоичное в git не кладём, но и терять нельзя - см. assets/README.md.
assets/*
!assets/README.md
