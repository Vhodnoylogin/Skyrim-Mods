# Что едет в Git LFS, и почему это решается расширением, а не размером.
#
# Правило одно: ДВОИЧНЫЙ файл версионируется через LFS независимо от веса. Git над
# двоичным хранит полную копию на каждое изменение и не показывает ни одного различия,
# поэтому маленький .esp вредит истории ровно так же, как большой меш, - просто медленнее.
# Размер тут ни при чём: вредит сам характер файла.
#
# Плата, о которой надо помнить: LFS не сжимает версии друг относительно друга - каждая
# правка кладётся целиком. Поэтому в LFS идёт то, что меняется редко и входит в выпуск,
# а не результат каждой сборки.
#
# Обратная сторона правила: у плагина есть ТЕКСТОВЫЙ исходник. Spriggit раскладывает .esp
# в дерево .yaml - по файлу на запись, - и правится, сливается и читается в различиях
# именно он. Двоичный .esp хранится рядом как продукт, чтобы мод собирался и там, где
# Spriggit не установлен. Смотри `claw\scripts\plugin.py`.

# --- Плагины и то, что игра грузит как плагин ---
*.esp   filter=lfs diff=lfs merge=lfs -text
*.esm   filter=lfs diff=lfs merge=lfs -text
*.esl   filter=lfs diff=lfs merge=lfs -text
*.bsa   filter=lfs diff=lfs merge=lfs -text
*.ba2   filter=lfs diff=lfs merge=lfs -text
*.seq   filter=lfs diff=lfs merge=lfs -text

# --- Собранный код: исходник текстовый, продукт двоичный ---
*.pex   filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.exe   filter=lfs diff=lfs merge=lfs -text
*.pdb   filter=lfs diff=lfs merge=lfs -text
*.lib   filter=lfs diff=lfs merge=lfs -text

# --- Геометрия, морфы, анимация, текстуры, звук ---
*.nif   filter=lfs diff=lfs merge=lfs -text
*.tri   filter=lfs diff=lfs merge=lfs -text
*.hkx   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.dds   filter=lfs diff=lfs merge=lfs -text
*.wav   filter=lfs diff=lfs merge=lfs -text
*.fuz   filter=lfs diff=lfs merge=lfs -text
*.xwm   filter=lfs diff=lfs merge=lfs -text

# --- Архивы ---
*.7z    filter=lfs diff=lfs merge=lfs -text
*.zip   filter=lfs diff=lfs merge=lfs -text

# --- Текст остаётся текстом ---
# Перечислено не ради настройки, а чтобы правило читалось целиком: вот это в LFS
# не попадает никогда, потому что различия по нему и есть смысл хранения.
*.psc   text
*.yaml  text
*.json  text
*.md    text
