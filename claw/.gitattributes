# Двоичные исходники мода версионируются через Git LFS: git хранит указатель в сорок
# строк, сам файл лежит рядом в хранилище LFS. Без этого история распухает, а клон
# становится неподъёмным - именно поэтому раньше assets\ вообще не версионировалась.
#
# ВАЖНО про стоимость: LFS НЕ сжимает версии друг относительно друга. Каждая правка
# файла кладётся целиком. Поэтому сюда идёт только то, что рецептом не выражается
# и меняется редко, а не результат каждой сборки - для него и написан журнал.
*.nif  filter=lfs diff=lfs merge=lfs -text
*.tri  filter=lfs diff=lfs merge=lfs -text
*.hkx  filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.esp  filter=lfs diff=lfs merge=lfs -text
*.esm  filter=lfs diff=lfs merge=lfs -text
*.esl  filter=lfs diff=lfs merge=lfs -text
*.dds  filter=lfs diff=lfs merge=lfs -text
*.7z   filter=lfs diff=lfs merge=lfs -text
